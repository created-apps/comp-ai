{
  "name": "comp-ai-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate && echo \"NOTE: generate updates the client only. If you changed schema.prisma, run: npm run db:migrate\"",
    "prisma:migrate": "prisma migrate dev",
    "seed:competitions": "tsx src/modules/competitions/seed.ts",
    "roster:import": "tsx src/modules/roster/import-csv.ts",
    "roster:sync": "tsx src/modules/roster/sync-sheet.ts",
    "picks:refresh": "tsx src/modules/recommend/top-picks-job.ts",
    "db:migrate": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:deploy": "prisma migrate deploy",
    "cosmic:sync-templates": "tsx src/modules/cosmic/templates-sync.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@chroma-core/default-embed": "^0.1.9",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@prisma/client": "^6.3.0",
    "@types/node-cron": "^3.0.11",
    "argon2": "^0.41.1",
    "bullmq": "^6.3.4",
    "chromadb": "^3.0.6",
    "fastify": "^5.2.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "prisma": "^6.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
