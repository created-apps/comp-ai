# Backend environment. Copy to backend/.env — the server refuses to boot on a
# missing or malformed value rather than starting in a half-configured state.

# ---------- database ----------
DATABASE_URL="postgresql://compai:compai@localhost:5432/compai?schema=public"

# ---------- chroma ----------
# The backend only ever reads from Chroma; the ingest script writes to it.
# Both must point at the same tenant/database/collection.
CHROMA_MODE=cloud
CHROMA_TENANT=
CHROMA_DATABASE=
CHROMA_API_KEY=
CHROMA_COLLECTION=competitions_v1
# only used when CHROMA_MODE=http (local docker-compose)
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ---------- auth ----------
# generate each: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---------- claude ----------
# Required by the recommendation pipeline and web verification.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# ---------- admin console (/admin) ----------
# Shared password for the internal admin page. Min 8 chars; rotate by changing
# this and restarting the backend.
ADMIN_PASSWORD=
ADMIN_SESSION_TTL=8h

# ---------- internal review notifications ----------
# Who is emailed when an enrolled student's recommendations need approving.
# Comma-separated. The email carries a "View competition details" button linking
# to WEB_ORIGIN/admin/reviews/<id>, so WEB_ORIGIN must be the public frontend URL.
# Leave blank and nobody is notified — the queue still fills, silently.
INTERNAL_REVIEW_EMAILS=

# ---------- google sheet roster (cron every 5h) ----------
# The service account JSON key, BASE64-ENCODED (not a file path, not raw JSON).
# The private key is a multi-line PEM block; pasting it raw into an env var turns
# the newlines into literal \n and every signature fails. Encode it with:
#   base64 -i service-account.json | tr -d '\n'
# Then share the sheet with the key's client_email (Viewer is enough).
GOOGLE_SERVICE_ACCOUNT_JSON=

ROSTER_SHEET_ID=
ROSTER_SHEET_TAB=Sheet1
ROSTER_SYNC_CRON="0 */5 * * *"
# Set true on exactly ONE instance. Two instances syncing the same sheet would
# race on persona upgrades. Scaling horizontally? Leave false and run
# `npm run roster:sync` from a real cron instead.
ROSTER_SYNC_ENABLED=false
# Note: signup also does a live one-address lookup against this sheet, so the
# credentials above are used even when the 5-hourly sync is disabled.

# ---------- email queue ----------
# The backend only PUBLISHES here. SendGrid credentials live in email-worker/.env
# — this service never talks to the provider. Must match email-worker/.env.
REDIS_URL=redis://localhost:6379

# ---------- top-3 competition picks (feeds Flow 2 / Email 2) ----------
# Nightly refresh of every enrolled student's three saved competitions.
# Set true on exactly ONE instance; each student costs two model calls.
TOP_PICKS_ENABLED=false
TOP_PICKS_CRON="0 2 * * *"
TOP_PICKS_BATCH_LIMIT=50

# ---------- competition verification ----------
# Verification runs on its own model. It is the highest-volume model call here —
# every competition, repeated as it goes stale — and the easiest: read the
# organiser's page and report what it says. The recommendation pipeline keeps
# CLAUDE_MODEL.
VERIFICATION_MODEL=claude-sonnet-5
# Checks competitions against their organiser's own site and files any change as
# a proposal for a human — stored dates are never overwritten automatically.
# Each check is a multi-turn web search, so a tick verifies a few rows, most
# urgent first (what students hold, then what families have been sent, then what
# closes soonest). Set true on exactly ONE instance.
VERIFICATION_ENABLED=false
VERIFICATION_CRON="0 * * * *"
VERIFICATION_BATCH_LIMIT=5
# Re-check a competition this long after its last successful verification.
VERIFICATION_STALE_DAYS=30
# A deadline inside this window makes a competition urgent.
VERIFICATION_DEADLINE_WINDOW_DAYS=45
# Never look at the same competition twice inside this window — including after
# a failure, which would otherwise crowd out everything else every tick.
VERIFICATION_COOLDOWN_HOURS=20

# ---------- entitlement ----------
# Competitions an enrolled student may activate when /admin has not set a
# per-student allowance for them.
DEFAULT_COMPETITION_ALLOWANCE=2

# ---------- COSMIC assignment ----------
# Where a selected competition is auto-assigned to the kid. comp-ai signs in as
# a COSMIC user with role=manager (same posture as the SYNC integration) and
# calls /api/v1/integrations/comp-ai/*. Leave COSMIC_PUSH_ENABLED=false and
# assignments still queue — nothing about selection depends on COSMIC being up.
COSMIC_API_URL=
COSMIC_SERVICE_EMAIL=
COSMIC_SERVICE_PASSWORD=
COSMIC_PUSH_ENABLED=false
# Retries the queue: students waiting on a COSMIC project, and transient failures.
COSMIC_RETRY_CRON="*/30 * * * *"
COSMIC_MAX_ATTEMPTS=8
COSMIC_RETRY_BATCH_LIMIT=50

# ---------- app ----------
PORT=4000
NODE_ENV=development
# Every origin allowed to call this API, comma-separated — a production front end
# plus its preview deployments. The first entry is the canonical one and is what
# internal review emails deep-link into. No cookies are set anywhere, so CORS is
# not credentialed: the browser sends session and admin tokens in the
# Authorization header.
#   e.g. WEB_ORIGIN=https://comp-ai.vercel.app,https://comp-ai-preview.vercel.app
WEB_ORIGIN=http://localhost:3000
