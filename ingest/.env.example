# Ingest environment. Copy to ingest/.env.
#
# The ingest is the only thing that WRITES to Chroma. These values must match
# backend/.env, which reads from the same collection — pointing them at
# different tenants is the failure that looks like "search returns nothing".

CHROMA_MODE=cloud
CHROMA_TENANT=
CHROMA_DATABASE=
CHROMA_API_KEY=
CHROMA_COLLECTION=competitions_v1

# Embedding backend. Changing this changes vector dimensionality, so pair any
# change with a new CHROMA_COLLECTION version and --reset.
EMBEDDING_BACKEND=default
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# EMBEDDING_API_KEY=          # only for EMBEDDING_BACKEND=openai-compatible
# EMBEDDING_API_BASE=

# Local alternatives (CHROMA_MODE=http | local)
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_PATH=../.chroma
