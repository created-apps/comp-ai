# Email worker. Copy to email-worker/.env.
#
# This is the ONLY service that holds SendGrid credentials. The backend just
# publishes jobs to Redis; if this worker is down, mail queues up rather than
# failing a signup.

# Must match backend/.env — same Redis, or nothing is ever delivered.
REDIS_URL=redis://localhost:6379

SENDGRID_API_KEY=
EMAIL_FROM=competitions@create-ed.in
EMAIL_FROM_NAME=Team CreatED
# Optional: every send is redirected here instead of the real recipient.
# Set it in staging so a copied production database cannot email real families.
# Leave blank to send to real recipients — a blank value is treated as unset.
EMAIL_REDIRECT_TO=

# Set false to render and log without calling SendGrid.
EMAIL_SEND_ENABLED=true

# How many emails to send concurrently.
WORKER_CONCURRENCY=5
